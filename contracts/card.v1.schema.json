{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload_version": {
      "type": "number",
      "const": 1
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "to": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "UTC days. Must satisfy to >= from and a span of at most 31 days (both ends inclusive)."
    },
    "active_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "sessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "usage": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_name": {
            "type": "string",
            "enum": [
              "claude_code",
              "vscode_copilot"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "speed": {
            "type": "string",
            "enum": [
              "standard",
              "fast",
              "unknown"
            ]
          },
          "prompt_floor": {
            "type": "integer",
            "minimum": -1,
            "maximum": 10000000000
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "cache_read_tokens": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "cache_creation_tokens": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "cache_creation_1h_tokens": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "web_search_requests": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "web_fetch_requests": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "copilot_credits": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens_estimated": {
            "type": "boolean"
          }
        },
        "required": [
          "tool_name",
          "model",
          "speed",
          "prompt_floor",
          "input_tokens",
          "output_tokens"
        ],
        "additionalProperties": false
      },
      "description": "Rows must be unique by (tool_name, model, speed, prompt_floor)."
    },
    "folders": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "required": [
          "project",
          "total_tokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "payload_version",
    "agent_version",
    "period",
    "active_days",
    "sessions",
    "usage"
  ],
  "additionalProperties": false
}
